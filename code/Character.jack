    function void initReversedSprites() {
        var int i;

        let characterSpriteReverse = Array.new(characterSpriteHeight);
        let airborneCharacterSpriteReverse = Array.new(characterSpriteHeight);

        let i = 0;
        while (i < characterSpriteHeight) {
            let characterSpriteReverse[i] = GraphicsUtils.reverse16(characterSprite[i]) & 32767;
            let airborneCharacterSpriteReverse[i] = GraphicsUtils.reverse16(airborneCharacterSprite[i]) & 32767;
            let i = i + 1;
        }

        return;
    }
}



