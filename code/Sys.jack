class Sys { 
    function void init() { 
        do Main.main(); 
        return; 
    } 
    
    function void wait(int duration) { 
        var int i, j; 
        
        let i = 0; 
        
        while (i < duration) { 
            let j = 0; 
            while (j < 500) { 
                let j = j + 1; 
            } 
            let i = i + 1; 
        } 
        return; 
    } 
}