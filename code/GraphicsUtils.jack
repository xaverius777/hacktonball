class GraphicsUtils {

    function int shiftRight(int value, int amount) {

        if (amount = 0) { return value; }
        if (amount = 1) { return value / 2; }
        if (amount = 2) { return value / 4; }
        if (amount = 3) { return value / 8; }
        if (amount = 4) { return value / 16; }
        if (amount = 5) { return value / 32; }
        if (amount = 6) { return value / 64; }
        if (amount = 7) { return value / 128; }
        if (amount = 8) { return value / 256; }
        if (amount = 9) { return value / 512; }
        if (amount = 10) { return value / 1024; }
        if (amount = 11) { return value / 2048; }
        if (amount = 12) { return value / 4096; }
        if (amount = 13) { return value / 8192; }
        if (amount = 14) { return value / 16384; }
        // Shifting a positive 16-bit value right by 15 bits clears all bits, so the result is always 0
        if (amount = 15) { return 0; }

        return 0; // fallback (should never happen)
    }

    function int shiftLeft(int value, int amount) {
        var int i;
        let i = 0;

        while (i < amount) {
            let value = value + value;
            let i = i + 1;
        }

        return value;
    }

    function int reverse16(int value) {
        var int i;
        var int reversed;
        var int bit;

        let i = 0;
        let reversed = 0;

        while (i < 16) {
            let bit = value & 1;

            let reversed = reversed + reversed;
            let reversed = reversed + bit;

            let value = value / 2;

            let i = i + 1;
        }

        return reversed;
    }
}
